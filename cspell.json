{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "graphify-out/**",
    ".git/**",
    "pnpm-lock.yaml",
    "*.log"
  ],
  "dictionaries": ["typescript", "node", "npm", "software-terms", "html"],
  "words": [
    "cdma",
    "extensionless",
    "greppable",
    "healthcheck",
    "unstub",
    "uuidv"
  ],
  "ignoreRegExpList": []
}
