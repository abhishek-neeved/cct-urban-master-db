# Fail the install (don't just warn) when a dev's Node/pnpm doesn't satisfy the
# "engines" field in package.json — keeps every environment on the same runtime.
engine-strict=true

# Reproducible installs: refuse to silently drift from the committed lockfile.
# (CI passes --frozen-lockfile explicitly; this guards local installs too.)

# Pin exact versions on `pnpm add` (no `^` ranges) so every dependency is
# locked in package.json, not just the lockfile.
save-exact=true
