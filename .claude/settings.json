{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(pnpm install)",
      "Bash(pnpm *)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "PowerShell(pnpm install)",
      "PowerShell(pnpm *)",
      "PowerShell(pnpm run *)",
      "PowerShell(pnpm exec *)",
      "PowerShell(pnpm dlx *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format.mjs",
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  }
}
