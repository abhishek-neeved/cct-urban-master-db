# Server
NODE_ENV=development
PORT=8000

# Logging
LOG_LEVEL=info
# Output format: json | pretty. Unset -> json in production, pretty otherwise.
LOG_FORMAT=pretty

# Database — use the direct connection string locally; in production against
# Supabase use the pooled (port 6543) connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/express_ts_layered

# App
APP_URL=http://localhost:8000

# CORS — comma-separated allowlist of origins. Leave empty in dev to reflect any
# origin; REQUIRED (non-empty) in production.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Auth (CHANGE JWT_ACCESS_SECRET in production — must be >= 32 chars there)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=60
