# Server
NODE_ENV=development
PORT=8000

# Logging
LOG_LEVEL=info
# Output format: json | pretty. Unset -> json in production, pretty otherwise.
LOG_FORMAT=pretty

# Database — a local mongod or a MongoDB Atlas connection string.
DATABASE_URL=mongodb://127.0.0.1:27017/express_ts_layered

# App
APP_URL=http://localhost:8000

# CORS — comma-separated allowlist of origins. Leave empty in dev to reflect any
# origin; REQUIRED (non-empty) in production. Set this to your frontend's dev
# server origin so the auth cookies (see docs/api-reference.md) work
# cross-origin — e.g. Vite's default port below.
CORS_ORIGINS=http://localhost:5173

# Auth (CHANGE JWT_ACCESS_SECRET in production — must be >= 32 chars there)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
# Shared by both the account-verification and password-reset OTP flows.
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# How long an account is locked out after 5 consecutive wrong passwords.
LOGIN_LOCKOUT_MINUTES=15

# Object storage (S3-compatible) for uploaded files — see docker-compose.yml
# for a local MinIO instance that works out of the box with the values below.
# Point S3_ENDPOINT at real AWS's default (leave unset) in production, where
# credentials should come from an IAM role rather than these static keys.
S3_BUCKET=cdma-uploads-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Razorpay — test-mode keys (rzp_test_...) work against the same API in dev,
# there is no separate sandbox host. Used for the one-time onboarding-fee
# payment link (see @modules/onboarding-fee) — no plan/subscription setup
# needed. All three values below must be changed to real ones in production
# (enforced at boot).
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=dev-razorpay-secret-change-me
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret-change-me

# CoinCircleTrust API-product platform — mobile-number-to-identity lookup used
# by KYC's mobile verification (see @modules/kyc). This is the real, billed
# endpoint — every call costs money. There is a sibling `.../mock/mobile-to-pan`
# path, but it returns fixed/unrelated test data regardless of the mobile
# number passed in, so it is NOT a stand-in for testing this feature's actual
# comparison logic — only use it to check connectivity/auth, never to verify
# real Aadhaar/PAN matching.
MOBILE_VERIFICATION_API_URL=https://apis.coincircletrust.com/api/v1/apiProduct/mobile-to-pan
MOBILE_VERIFICATION_API_KEY=mobile-verification-api-key-placeholder
