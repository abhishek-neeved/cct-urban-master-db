{
  "name": "cdma-master-db",
  "version": "1.0.0",
  "description": "CDMA Master DB — Express + TypeScript REST API on a feature-modular layered architecture (MVC + Service + Repository) with dependency inversion at the data-access boundary",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "nodemon",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "spell": "cspell lint --no-progress --no-must-find-files \"**/*.{ts,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/s3-request-presigner": "3.1097.0",
    "@casl/ability": "7.0.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "http-status-codes": "2.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.2",
    "razorpay": "2.9.8",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "uuid": "14.0.1",
    "winston": "3.19.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.1.1",
    "@types/supertest": "7.2.0",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "4.1.10",
    "cspell": "10.0.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "knip": "6.26.0",
    "lint-staged": "17.0.8",
    "mongodb-memory-server": "11.2.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.5",
    "supertest": "7.2.2",
    "tsc-alias": "1.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
